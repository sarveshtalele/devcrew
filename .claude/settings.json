{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read|Grep|Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-guard.sh" }] },
      { "matcher": "Write|Edit",     "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-guard.sh" }] },
      { "matcher": "Bash",           "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-guard.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-meter.sh" }] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash tests/cli.test.sh)",
      "Bash(bash -n:*)",
      "Bash(./bin/devcrew:*)",
      "Bash(shellcheck:*)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(rg:*)", "Bash(jq:*)", "Bash(ls:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)", "Bash(npm publish:*)"],
    "deny": [
      "Read(./**/.env)", "Read(./**/*.pem)",
      "Bash(git push --force:*)", "Bash(git commit:*--no-verify*)"
    ]
  }
}
